<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EukyreConsortium</RootNamespace>
    <AssemblyName>EukyreConsortium</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>2.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
    <!-- Does the item/assort/preset/locale registration this mod used to hand-roll in TS. -->
    <PackageReference Include="WTT-ServerCommonLib" Version="3.0.6" />
  </ItemGroup>

  <!--
    The mod folder is db + bundles + the dll. WTT reads the json straight out of the deployed
    folder, so db has to travel with the build; bundles are 1.1 GB and are copied by the
    deploy target instead of the build output.
  -->
  <ItemGroup>
    <None Include="..\db\**\*.json" LinkBase="db" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\bundles.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DeployToSpt" AfterTargets="Build" Condition=" '$(DeployToSpt)' != 'false' AND Exists('$(SptRoot)') ">
    <PropertyGroup>
      <SptModDir>$(SptRoot)\SPT\user\mods\EukyreConsortium\</SptModDir>
    </PropertyGroup>
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)**\*.*" />
      <BundleFiles Include="..\bundles\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFiles="@(DeployFiles->'$(SptModDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BundleFiles)" DestinationFiles="@(BundleFiles->'$(SptModDir)bundles\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed EukyreConsortium to $(SptModDir)" />
  </Target>

</Project>
